# Variáveis do ambiente de STAGING
# No pipeline, o arquivo deploy/staging.env é gerado automaticamente a partir dos
# Secrets/Variables do GitHub Environment "staging" (valores abaixo são o fallback).
API_IMAGE=ghcr.io/analuarcanjo/ecotrack-devops:staging
APP_VERSION=local
API_PORT=8081
DB_PORT=14331
SA_PASSWORD=Staging@EcoTrack123
DB_NAME=EcoTrackDb_Staging
JWT_SECRET=staging-ecotrack-secret-key-trocar-por-valor-aleatorio-com-64-chars-ou-mais
JWT_EXPIRATION_MINUTES=120
