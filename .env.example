# =============================================================
#  Variáveis de ambiente — execução LOCAL com Docker Compose
#  Copie para .env:   cp .env.example .env
#  (o .env real NÃO vai para o Git — está no .gitignore)
# =============================================================

# Imagem e versão da API (local = build a partir do Dockerfile)
API_IMAGE=ecotrack-api:local
APP_VERSION=local
ASPNETCORE_ENVIRONMENT=Development

# Portas expostas no host
API_PORT=8080
DB_PORT=1433

# SQL Server (mínimo 8 caracteres com maiúscula, minúscula, número e símbolo)
SA_PASSWORD=EcoTrack@123
DB_NAME=EcoTrackDb

# JWT (use uma chave longa e aleatória fora do ambiente local)
JWT_SECRET=ecotrack-net-super-secret-key-2026-must-be-at-least-256-bits-long-for-hmac
JWT_EXPIRATION_MINUTES=1440
